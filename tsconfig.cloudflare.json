{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.cloudflare.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "WebWorker"],
    "module": "esnext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": false,
    "rootDir": ".",
    "outDir": "./cloudflare/dist",
    "declaration": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "cloudflare/src/**/*.ts",
    "cloudflare/src/**/*.d.ts",
    "src/game/**/*.ts",
    "server/src/contracts.ts"
  ],
  "exclude": [
    "cloudflare/src/**/*.test.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "server/src/**/*.test.ts"
  ]
}
