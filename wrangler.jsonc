{
  "name": "xiangqi-online",
  "main": "cloudflare/src/worker.ts",
  "compatibility_date": "2025-05-21",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/rooms/*/ws",
      "/ws",
      "/health"
    ]
  },
  // To bind a custom domain, uncomment and replace the example below.
  // "routes": [
  //   {
  //     "pattern": "xiangqi.example.com",
  //     "custom_domain": true
  //   }
  // ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_OBJECT",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    }
  ],
  "vars": {
    "CORS_ORIGINS": "https://xiangqi.example.com"
  }
}
